      "Bash(git push:*)",
      "Skill(pr-merge)",
      "Bash(gh pr:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "WebSearch",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh release:*)",
